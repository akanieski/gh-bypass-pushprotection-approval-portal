# Docker Compose settings; dotnet run does not load this file.
PORTAL_ENABLED=false
# FileSystem (default) or S3. Switching providers does not migrate existing state.
# FileSystem needs no storage service, S3 settings, or storage credentials.
# In Docker, approval state is /data/approvals; cookie keys are /data/keys.
# The portal-data volume persists /data. Change its mapping in compose.yaml to use a host directory.
# For dotnet run, set Portal__DataDirectory to an absolute local path (default: data).
# The app stores approvals and keys in subdirectories of that path. Keep it private and backed up.
STORAGE_PROVIDER=FileSystem
PORTAL_PUBLIC_ORIGIN=https://approvals.customer.example
GITHUB_OAUTH_CLIENT_ID=
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=0
GITHUB_REPOSITORY=example-org/example-repo
APPROVER_ID_1=0
APPROVER_ID_2=0
# Exact IP of the trusted HTTPS reverse proxy as seen inside the container.
TRUSTED_PROXY_IP=127.0.0.1
POLL_SECONDS=60
# S3 only; add compose.s3.yaml (or compose.minio.yaml) to mount storage credentials.
S3_ENDPOINT=https://s3.customer.example
S3_REGION=us-east-1
S3_BUCKET=customer-approvals
S3_PREFIX=approval-portal/
S3_PATH_STYLE=true
