# Settings for Docker Compose and Start-LocalDev.ps1; plain dotnet run does not load this file.
PORTAL_ENABLED=false
# FileSystem is the default. No storage service or storage credentials are needed.
# In Docker, approval state is /data/approvals; cookie keys are /data/keys.
# The portal-data volume persists /data. Change its mapping in compose.yaml to use a host directory.
# Start-LocalDev.ps1 uses the repository's data directory and local secrets files.
# For plain dotnet run, set Portal__DataDirectory to an absolute local path (default: data).
# The app stores approvals and keys in subdirectories of that path. Keep it private and backed up.
STORAGE_PROVIDER=FileSystem
PORTAL_PUBLIC_ORIGIN=https://approvals.customer.example
# Start-LocalDev.ps1 overrides the public origin with https://localhost:7443 (or -Url).
GITHUB_OAUTH_CLIENT_ID=
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=0
GITHUB_REPOSITORY=example-org/example-repo
APPROVER_ID_1=0
APPROVER_ID_2=0
# Exact IP of the trusted HTTPS reverse proxy as seen inside the container.
TRUSTED_PROXY_IP=127.0.0.1
POLL_SECONDS=60
