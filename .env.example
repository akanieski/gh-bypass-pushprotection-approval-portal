PORTAL_ENABLED=false
PORTAL_PUBLIC_ORIGIN=https://approvals.customer.example
GITHUB_OAUTH_CLIENT_ID=
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=0
GITHUB_REPOSITORY=example-org/example-repo
APPROVER_ID_1=0
APPROVER_ID_2=0
# Exact IP of the trusted HTTPS reverse proxy as seen inside the container.
TRUSTED_PROXY_IP=127.0.0.1
POLL_SECONDS=60
S3_ENDPOINT=https://s3.customer.example
S3_REGION=us-east-1
S3_BUCKET=customer-approvals
S3_PREFIX=approval-portal/
S3_PATH_STYLE=true
